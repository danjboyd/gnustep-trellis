# Plain-clang build for macOS (Apple Foundation; no GNUstep make needed).
#   make -f Makefile.macos && make -f Makefile.macos check
CC      ?= clang
CFLAGS  ?= -O2 -g
CFLAGS  += -fobjc-arc -fblocks -Wall -Wno-unused-function -ISource/Engine
# make -f Makefile.macos hot_reload=no compiles TRLoader's dev hot-reload out.
ifeq ($(hot_reload),no)
CFLAGS  += -DTR_NO_HOT_RELOAD
endif
B       := build

ENGINE_SRC := Source/Engine/TRStyle.m Source/Engine/TRNode.m Source/Engine/TRLayout.m Source/Engine/TRContainerQuery.m Source/Engine/TRLint.m Source/Engine/TRMarkup.m Source/Engine/TRGrid.m Source/Engine/TRVirtualLayout.m

VIEW_SRC   := Source/View/TRBoxView.m Source/View/TRViewMeasure.m Source/View/TRLoader.m Source/View/TRVirtualBox.m

all: $(B)/libTrellisEngine.dylib $(B)/trellis-case

# Views, tools and the Preview app (AppKit). Building needs no GUI session.
gui: $(B)/libTrellis.dylib $(B)/trellis-lint $(B)/trellis-render $(B)/trellis-bench $(B)/TrellisPreview.app

$(B):
	mkdir -p $(B)

$(B)/libTrellisEngine.dylib: $(ENGINE_SRC) Source/Engine/*.h | $(B)
	$(CC) $(CFLAGS) -dynamiclib -install_name @rpath/libTrellisEngine.dylib \
	  -framework Foundation $(ENGINE_SRC) -o $@

$(B)/trellis-case: Tools/trellis-case.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tools/trellis-case.m -o $@

$(B)/virtual-layout: Tests/Engine/virtual-layout.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -ISource/Engine -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tests/Engine/virtual-layout.m -o $@

$(B)/custom-properties: Tests/Engine/custom-properties.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -ISource/Engine -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tests/Engine/custom-properties.m -o $@

$(B)/libTrellis.dylib: $(VIEW_SRC) Source/View/*.h $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -ISource/View -dynamiclib -install_name @rpath/libTrellis.dylib \
	  -framework AppKit -L$(B) -lTrellisEngine $(VIEW_SRC) -o $@

$(B)/trellis-lint: Tools/trellis-lint.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tools/trellis-lint.m -o $@

$(B)/trellis-bench: Tools/trellis-bench.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tools/trellis-bench.m -o $@

$(B)/trellis-render: Tools/trellis-render.m Tools/TRSamples.m $(B)/libTrellis.dylib
	$(CC) $(CFLAGS) -ISource/View -framework AppKit -L$(B) -lTrellis -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tools/trellis-render.m Tools/TRSamples.m -o $@

$(B)/TrellisPreview.app: Tools/TrellisPreview/TPController.m $(B)/libTrellis.dylib
	rm -rf $@ && mkdir -p $@/Contents/MacOS $@/Contents/Frameworks
	$(CC) $(CFLAGS) -ISource/View -framework AppKit -L$(B) -lTrellis -lTrellisEngine \
	  -Wl,-rpath,@executable_path/../Frameworks Tools/TrellisPreview/TPController.m \
	  -o $@/Contents/MacOS/TrellisPreview
	cp $(B)/libTrellis.dylib $(B)/libTrellisEngine.dylib $@/Contents/Frameworks/
	printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' \
	  '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
	  '<plist version="1.0"><dict>' \
	  '<key>CFBundleExecutable</key><string>TrellisPreview</string>' \
	  '<key>CFBundleIdentifier</key><string>org.gnustep.trellis.preview</string>' \
	  '<key>CFBundleName</key><string>Trellis Preview</string>' \
	  '<key>CFBundlePackageType</key><string>APPL</string>' \
	  '<key>NSPrincipalClass</key><string>NSApplication</string>' \
	  '<key>NSHighResolutionCapable</key><true/>' \
	  '</dict></plist>' > $@/Contents/Info.plist

# The conformance report: each failing case id, then the totals, per-suite
# rates and skip reasons.
CONF_SUMMARY = sed -n -e 's/^FAIL \([^ :]*\).*/  fail: \1/p' -e '/^PASS /,$$p'

check: all $(B)/virtual-layout $(B)/custom-properties
	$(B)/trellis-case Tests/Engine/cases
	$(B)/virtual-layout
	$(B)/custom-properties
	@if [ -d Tests/Conformance/cases ]; then $(B)/trellis-case Tests/Conformance/cases | $(CONF_SUMMARY) || true; fi

# Record this platform's results in docs/conformance/macos.json and
# regenerate the README table (scripts/conformance-summary.py).
conformance-record: all
	python3 -I scripts/conformance-summary.py record --platform macos --runner $(B)/trellis-case
	python3 -I scripts/conformance-summary.py table

# Unit tests for the conformance importers (Python, no build needed).
check-importers:
	python3 -I Tests/Conformance/tools/test_import_wpt.py

clean:
	rm -rf $(B)
.PHONY: all gui check check-importers conformance-record clean
