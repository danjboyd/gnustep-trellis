# Plain-clang build for macOS (Apple Foundation; no GNUstep make needed).
#   make -f Makefile.macos && make -f Makefile.macos check
CC      ?= clang
CFLAGS  ?= -O2 -g
CFLAGS  += -fobjc-arc -fblocks -Wall -Wno-unused-function -ISource/Engine
# make -f Makefile.macos hot_reload=no compiles TRLoader's dev hot-reload out.
ifeq ($(hot_reload),no)
CFLAGS  += -DTR_NO_HOT_RELOAD
endif
B       := build

ENGINE_SRC := Source/Engine/TRStyle.m Source/Engine/TRNode.m Source/Engine/TRLayout.m Source/Engine/TRContainerQuery.m Source/Engine/TRLint.m Source/Engine/TRMarkup.m Source/Engine/TRGrid.m Source/Engine/TRVirtualLayout.m

VIEW_SRC   := Source/View/TRBoxView.m Source/View/TRViewMeasure.m Source/View/TRLoader.m Source/View/TRVirtualBox.m Source/View/TRSplitView.m

all: $(B)/libTrellisEngine.dylib $(B)/trellis-case

# Views, tools and the Preview app (AppKit). Building needs no GUI session.
gui: $(B)/libTrellis.dylib $(B)/trellis-lint $(B)/trellis-render $(B)/trellis-bench $(B)/TrellisPreview.app

$(B):
	mkdir -p $(B)

$(B)/libTrellisEngine.dylib: $(ENGINE_SRC) Source/Engine/*.h | $(B)
	$(CC) $(CFLAGS) -dynamiclib -install_name @rpath/libTrellisEngine.dylib \
	  -framework Foundation $(ENGINE_SRC) -o $@

$(B)/trellis-case: Tools/trellis-case.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tools/trellis-case.m -o $@

$(B)/virtual-layout: Tests/Engine/virtual-layout.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -ISource/Engine -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tests/Engine/virtual-layout.m -o $@

$(B)/custom-properties: Tests/Engine/custom-properties.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -ISource/Engine -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tests/Engine/custom-properties.m -o $@

$(B)/lint-targets: Tests/Engine/lint-targets.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -ISource/Engine -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tests/Engine/lint-targets.m -o $@

$(B)/logical-style: Tests/Engine/logical-style.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -ISource/Engine -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tests/Engine/logical-style.m -o $@

$(B)/calc-locale: Tests/Engine/calc-locale.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -ISource/Engine -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tests/Engine/calc-locale.m -o $@

$(B)/markup-scale: Tests/Engine/markup-scale.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -ISource/Engine -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tests/Engine/markup-scale.m -o $@

$(B)/libTrellis.dylib: $(VIEW_SRC) Source/View/*.h $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -ISource/View -dynamiclib -install_name @rpath/libTrellis.dylib \
	  -framework AppKit -L$(B) -lTrellisEngine $(VIEW_SRC) -o $@

$(B)/trellis-lint: Tools/trellis-lint.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tools/trellis-lint.m -o $@

$(B)/trellis-bench: Tools/trellis-bench.m $(B)/libTrellisEngine.dylib
	$(CC) $(CFLAGS) -framework Foundation -L$(B) -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tools/trellis-bench.m -o $@

$(B)/trellis-render: Tools/trellis-render.m Tools/TRSamples.m $(B)/libTrellis.dylib
	$(CC) $(CFLAGS) -ISource/View -framework AppKit -L$(B) -lTrellis -lTrellisEngine \
	  -Wl,-rpath,@executable_path Tools/trellis-render.m Tools/TRSamples.m -o $@

$(B)/TrellisPreview.app: Tools/TrellisPreview/TPController.m $(B)/libTrellis.dylib
	rm -rf $@ && mkdir -p $@/Contents/MacOS $@/Contents/Frameworks
	$(CC) $(CFLAGS) -ISource/View -framework AppKit -framework UniformTypeIdentifiers \
	  -L$(B) -lTrellis -lTrellisEngine \
	  -Wl,-rpath,@executable_path/../Frameworks Tools/TrellisPreview/TPController.m \
	  -o $@/Contents/MacOS/TrellisPreview
	cp $(B)/libTrellis.dylib $(B)/libTrellisEngine.dylib $@/Contents/Frameworks/
	printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' \
	  '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
	  '<plist version="1.0"><dict>' \
	  '<key>CFBundleExecutable</key><string>TrellisPreview</string>' \
	  '<key>CFBundleIdentifier</key><string>org.gnustep.trellis.preview</string>' \
	  '<key>CFBundleName</key><string>Trellis Preview</string>' \
	  '<key>CFBundlePackageType</key><string>APPL</string>' \
	  '<key>NSPrincipalClass</key><string>NSApplication</string>' \
	  '<key>NSHighResolutionCapable</key><true/>' \
	  '</dict></plist>' > $@/Contents/Info.plist

# The conformance report: each failing case id, then the totals, per-suite
# rates and skip reasons.
CONF_SUMMARY = sed -n -e 's/^FAIL \([^ :]*\).*/  fail: \1/p' -e '/^PASS /,$$p'

check: all $(B)/virtual-layout $(B)/custom-properties $(B)/lint-targets $(B)/markup-scale $(B)/logical-style $(B)/calc-locale
	$(B)/trellis-case Tests/Engine/cases
	$(B)/virtual-layout
	$(B)/custom-properties
	$(B)/lint-targets
	$(B)/markup-scale
	$(B)/logical-style
	$(B)/calc-locale
	@if [ -d Tests/Conformance/cases ]; then $(B)/trellis-case Tests/Conformance/cases | $(CONF_SUMMARY) || true; fi

# Record this platform's results in docs/conformance/macos.json and
# regenerate the README table (scripts/conformance-summary.py).
conformance-record: all
	python3 -I scripts/conformance-summary.py record --platform macos --runner $(B)/trellis-case
	python3 -I scripts/conformance-summary.py table

# The view tests, headless and window-free (nothing is ordered front), each
# under NSZombieEnabled except the benchmark. A test fails on a non-zero
# exit, a FAIL line, or a message to a freed object. preview-open-file is
# GNUstep's alert check (it needs -finishLaunching in a GUI session), so it
# is left out. Needs hot reload compiled in (no hot_reload=no) for HOTRELOAD.
VIEW_TESTS := $(filter-out preview-open-file,$(basename $(notdir $(wildcard Tests/View/*.m))))
TIMEOUT    := perl -e 'alarm shift; exec @ARGV or die'

check-view: gui
	@mkdir -p $(B)/view-tests
	@for t in $(VIEW_TESTS); do \
	  $(CC) $(CFLAGS) -Wno-deprecated-declarations -ISource/View -ITools Tests/View/$$t.m -framework AppKit \
	    -L$(B) -lTrellis -lTrellisEngine -Wl,-rpath,$(CURDIR)/$(B) -o $(B)/view-tests/$$t || exit 1; \
	done
	@status=0; for t in $(VIEW_TESTS); do \
	  log=$(B)/view-tests/$$t.log; \
	  if [ $$t = virtual-bench ]; then z=NO; else z=YES; fi; \
	  NSZombieEnabled=$$z $(TIMEOUT) 120 $(B)/view-tests/$$t > $$log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ] || grep -q '^FAIL\| FAIL' $$log; then echo "$$t: FAIL (exit $$rc)"; grep 'FAIL' $$log | head -5; status=1; \
	  elif grep -q 'deallocated instance' $$log; then echo "$$t: FAIL (message to a freed object)"; status=1; \
	  else tail -1 $$log; fi; \
	done; \
	RENDER=$(B)/trellis-render bash Tests/View/scroll-container-query.sh | tail -1 || status=1; \
	LINT=$(B)/trellis-lint bash Tests/Markup/run.sh > $(B)/view-tests/markup.log 2>&1 || status=1; \
	grep 'cases' $(B)/view-tests/markup.log; \
	if [ $$status -eq 0 ]; then echo "CHECKVIEW OK"; else echo "CHECKVIEW FAIL"; fi; exit $$status

# Frame replay (scripts/check-reference.py): the golden dumps in
# Tests/Reference/dumps and dogfood/frames, from either platform, laid out
# again by this engine; then a self-test that a changed geometry value in
# each dump is caught. Engine only: no windows, no AppKit.
check-reference: all
	python3 -I scripts/check-reference.py replay --runner $(B)/trellis-case
	python3 -I scripts/check-reference.py selftest --runner $(B)/trellis-case

# TrellisPreview's snapshot/export path (Tests/View/preview-export.sh),
# headless: a copy of the app marked LSUIElement (no Dock icon) whose
# window is never ordered front, so it runs over ssh.
check-preview: gui
	python3 -I Tests/View/test_png_check.py
	rm -rf $(B)/preview-check && mkdir -p $(B)/preview-check
	cp -R $(B)/TrellisPreview.app $(B)/preview-check/
	/usr/libexec/PlistBuddy -c 'Add :LSUIElement bool true' $(B)/preview-check/TrellisPreview.app/Contents/Info.plist
	PREVIEW=$(CURDIR)/$(B)/preview-check/TrellisPreview.app/Contents/MacOS/TrellisPreview bash Tests/View/preview-export.sh

# The frames that changed from 0.5.x to 0.7 (docs/migration-0.7.md), on
# the migration fixture, window-free.
check-migration: gui
	python3 -I scripts/check-migration.py --render $(B)/trellis-render

# Unit tests for the conformance importers (Python, no build needed).
check-importers:
	python3 -I Tests/Conformance/tools/test_import_wpt.py
	python3 -I Tests/Conformance/tools/test_snapshot_diff.py

clean:
	rm -rf $(B)
.PHONY: all gui check check-view check-preview check-reference check-migration check-importers conformance-record clean
