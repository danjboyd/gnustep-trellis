  },
  "direction": "rtl"
 },
 {
  "id": "engine/abspos_static_grid_parent",
  "note": "a static grid parent: the abspos child uses the ancestor, not a grid area",
  "root": {
   "style": "width: 200px; height: 100px",
   "children": [
