     ]
    }
   ]
  },
  "expected": {
   "x": 0,
   "y": 0,
   "width": 200,
   "height": 100,
   "children": [
    {
     "x": 100,
     "y": 0,
     "width": 100,
     "height": 50,
     "children": [
      {
       "x": 70,
       "y": 0,
       "width": 20,
       "height": 10
      }
     ]
    }
