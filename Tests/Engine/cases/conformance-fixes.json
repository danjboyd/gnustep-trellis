 {
  "id": "engine/fit_content_column_holds_unshrinkable_child",
  "note": "Yoga align_items_center_child_without_margin_bigger_than_parent",
  "root": {
   "style": {
    "flexDirection": "column",
    "alignItems": "center",
    "width": 52,
    "height": 52
   },
   "children": [
    {
     "style": {
      "flexDirection": "column"
     },
     "children": [
      {
       "style": {
        "width": 72,
        "height": 72
       }
      }
     ]
    }
   ]
  },
  "expected": {
   "children": [
    {
     "x": -10,
     "width": 72
    }
   ]
  }
 },
 {
  "id": "engine/fit_content_wrapped_row_takes_available_width",
  "note": "Yoga wrapped_row_within_align_items_center",
  "root": {
   "style": {
    "flexDirection": "column",
    "alignItems": "center",
    "width": 200,
    "height": 200
   },
   "children": [
    {
     "style": {
      "flexWrap": "wrap"
     },
     "children": [
      {
       "style": {
        "width": 150,
        "height": 80,
        "flexShrink": 0
       }
      },
      {
       "style": {
        "width": 80,
        "height": 80,
        "flexShrink": 0
       }
      }
     ]
    }
   ]
  },
  "expected": {
   "children": [
    {
     "x": 0,
     "width": 200,
     "height": 160
    }
   ]
  }
 },
 {
  "id": "engine/root_min_width_beats_width",
