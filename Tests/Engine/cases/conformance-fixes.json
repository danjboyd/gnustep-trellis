     "style": {
      "gridRow": "-3",
      "gridColumn": "1",
      "height": 10
     }
    },
    {
     "style": {
      "height": 10
     }
    }
   ]
  },
  "expected": {
   "children": [
    {
     "y": 0,
     "height": 10
    },
    {
     "y": 10,
     "height": 10
    }
   ]
  }
 },
