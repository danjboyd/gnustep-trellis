    }
   ]
  }
 },
 {
  "id": "engine/item_max_width_bounds_text_measure",
  "note": "Yoga contains_inner_text_max_width: text wraps at the item's max-width",
  "root": {
   "style": {
    "flexDirection": "column",
    "alignItems": "flex-start",
    "width": 400,
    "height": 400
   },
   "children": [
    {
     "style": {
      "maxWidth": 50
     },
     "measure": {
      "text": "aaaa bbbb cccc dddd",
      "charWidth": 10,
      "lineHeight": 10
     }
    }
   ]
  },
  "expected": {
   "children": [
    {
     "width": 40,
     "height": 40
    }
   ]
  }
 },
 {
  "id": "engine/auto_height_not_limited_by_available",
  "note": "WPT align-content-wrap-002: an auto-height item keeps its content height",
  "root": {
   "style": {
    "flexWrap": "wrap",
    "width": 300,
    "height": 100
   },
   "children": [
    {
     "style": {
      "width": 100,
      "flexShrink": 0
     },
     "children": [
      {
       "style": {
        "width": 50,
        "height": 150
       }
      }
     ]
    }
   ]
  },
  "expected": {
   "children": [
    {
     "height": 150,
     "children": [
      {
       "height": 150
      }
     ]
    }
   ]
  }
 },
 {
