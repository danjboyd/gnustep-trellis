[
 {
  "id": "engine/abspos_baseline_falls_back_to_start_in_wrap_reverse",
  "note": "WPT flex-abspos-staticpos-align-self-002: baseline -> start, not flex-start",
  "root": {
   "style": {
    "flexWrap": "wrap-reverse",
    "alignItems": "center",
    "width": 20,
    "height": 20
   },
   "children": [
    {
     "style": {
      "position": "absolute",
      "width": 8,
      "height": 6,
      "alignSelf": "baseline"
     }
    }
   ]
  },
  "expected": {
   "children": [
    {
     "x": 0,
     "y": 0
    }
   ]
  }
 },
 {
  "id": "engine/justify_right_in_column_is_start",
  "note": "WPT flexbox_justifycontent-rtl-002: left/right are physical; in a column they act as start",
  "root": {
   "style": {
    "flexDirection": "column",
    "justifyContent": "right",
    "width": 20,
    "height": 20
   },
   "children": [
    {
     "style": {
      "width": 8,
      "height": 6
     }
    }
   ]
  },
  "expected": {
   "children": [
    {
     "x": 0,
     "y": 0
    }
   ]
  }
 },
 {
  "id": "engine/justify_left_in_rtl_row_is_end",
  "direction": "rtl",
  "root": {
   "style": {
    "justifyContent": "left",
    "width": 20,
    "height": 20
   },
   "children": [
    {
     "style": {
      "width": 8,
      "height": 6,
      "alignSelf": "flex-start"
     }
    }
   ]
  },
  "expected": {
   "children": [
    {
     "x": 0,
     "y": 0
    }
   ]
  }
 },
