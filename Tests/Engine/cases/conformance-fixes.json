  },
  "expected": {
   "width": 100
  }
 },
 {
  "id": "engine/percent_inside_fit_content_is_indefinite",
  "note": "Yoga percentage_container_in_wrapping_container",
  "root": {
   "style": {
    "flexDirection": "column",
    "alignItems": "center",
    "width": 200,
    "height": 200
   },
   "children": [
    {
     "style": {
      "flexDirection": "column"
     },
     "children": [
      {
       "style": {
        "width": "100%",
        "justifyContent": "center"
       },
       "children": [
        {
         "style": {
          "width": 50,
          "height": 50
         }
        },
        {
         "style": {
          "width": 50,
          "height": 50
         }
        }
       ]
      }
     ]
    }
   ]
  },
  "expected": {
   "children": [
    {
     "x": 50,
     "width": 100,
     "children": [
      {
       "width": 100
      }
     ]
    }
   ]
  }
 },
 {
  "id": "engine/percent_of_fit_content_root_width",
  "note": "Yoga percent_of_minmax_main",
  "root": {
   "style": {
    "minWidth": 60,
    "maxWidth": 60,
    "height": 50
   },
   "children": [
    {
     "style": {
      "width": "50%",
      "height": 20
     }
    }
   ]
