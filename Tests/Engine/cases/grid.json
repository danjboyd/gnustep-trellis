   "style": "display: grid; grid-template-columns: 100px 100px; grid-template-rows: 80px 80px; width: 200px; height: 160px",
   "children": [
    {
     "style": "position: absolute; grid-column: 2 / 3; grid-row: 1 / 2; width: 20px; height: 10px; justify-self: end; align-self: center"
    },
    {
     "style": "position: absolute; grid-column: 1 / 2; grid-row: 2 / 3; width: 20px; height: 10px; justify-self: center; align-self: end; margin: 0 0 5px 0"
    },
    {
     "style": "position: absolute; grid-column: 1 / 3; grid-row: 1; height: 10px; justify-self: stretch; margin-left: 10px"
    }
   ]
  },
  "expected": {
   "x": 0,
   "y": 0,
   "width": 200,
   "height": 160,
   "children": [
    {
     "x": 180,
     "y": 35,
     "width": 20,
     "height": 10
    },
    {
     "x": 40,
     "y": 145,
     "width": 20,
     "height": 10
    },
    {
     "x": 10,
     "y": 0,
     "width": 190,
     "height": 10
    }
   ]
  }
 },
