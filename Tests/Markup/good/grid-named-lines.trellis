<column class="page">
  <label class="side">Side</label>
  <label class="main">Main</label>
  <label class="wide">Wide</label>
  <style>
    .page { display: grid; grid-template-columns: [side-start] 120px [side-end main-start] 1fr [main-end];
            grid-template-rows: repeat(2, [row] auto); gap: 8px; }
    .side { grid-column: side; grid-row: 1 row; }
    .main { grid-column: main; grid-row: 1 row; }
    .wide { grid-column: side-start / main-end; grid-row: span row; }
  </style>
</column>
