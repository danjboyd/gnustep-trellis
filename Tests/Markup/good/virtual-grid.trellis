<column>
  <label>Agents</label>
  <virtual id="wall" layout="grid" template="tile" estimated-size="60">
    <template id="tile"><column class="tile"><label id="name">agent-0001</label><label id="state">Working</label></column></template>
    <template id="group"><label class="group" id="title">Group</label></template>
  </virtual>
  <style>
    #wall { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; padding: 12px; }
    .group { grid-column: 1 / -1; font-weight: bold; }
    .tile { padding: 6px; gap: 2px; }
  </style>
</column>
