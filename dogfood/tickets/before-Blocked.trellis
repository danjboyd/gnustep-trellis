<!-- owner: AIMTriageDeskView -->
<!-- AIManager's Tickets desk (Blocked state) as it lays out today, approximated
     in Trellis for a before/after comparison (from agent-tickets'
     description of AIMTriageDeskView -layout). Not a proposal. -->
<column id="desk" class="desk">
  <row id="pulse" class="pulse">
    <button id="railToggle" class="narrow-only" action="toggleRail:">☰ Rail</button>
    <button class="chip urgent" action="filterPulse:">P1: 1</button>
    <button class="chip" action="filterPulse:">Need you: 6</button>
    <button class="chip" action="filterPulse:">Replies: 2</button>
    <button class="chip" action="filterPulse:">Blocked: 1</button>
  </row>
  <separator/>

  <box class="body">
    <column class="railpane">
      <field id="filter" placeholder="Filter tickets"/>
      <scroll id="rail" class="rail">
        <column class="rail-list">
          <label class="section" no-outlet="yes">YOUR MOVE 6</label>
          <label class="group" no-outlet="yes">Verify</label>
          <column class="row"><label class="row-title">2396  Fuel log export missing columns</label><label class="row-meta">Bob Example · 2h ●</label></column>
          <column class="row"><label class="row-title">2398  Map tiles blank offline</label><label class="row-meta">Carol Example · 3h</label></column>
          <label class="section" no-outlet="yes">▸ WITH AGENTS 4</label>
          <label class="section" no-outlet="yes">▸ WITH REQUESTERS 2</label>
          <label class="section" no-outlet="yes">▾ BLOCKED 1</label>
          <column class="row selected"><label class="row-title">2409  Field tablets can't sync after the 11/14 update</label><label class="row-meta">Alice Example · 5h ◷</label></column>
          <label class="section" no-outlet="yes">▸ PROJECTS 3</label>
          <label class="section" no-outlet="yes">▸ SNOOZED 1</label>
        </column>
      </scroll>
    </column>

    <column class="main">
      <scroll class="cardscroll">
        <column class="cardtext">
          <text id="card" class="card-title">TKT-1409  Field tablets can't sync after the 11/14 update</text>
          <text class="muted">Alice Example · Field Ops · P2 · opened 5h ago</text>
          <text>Since the 11/14 update, tablets in the north site stop syncing after about ten minutes. A restart fixes it until the next shift. Three crews are affected.</text>
          <label class="heading" no-outlet="yes">Waiting on</label>
          <text>• TKT-1402 Monthly budget export times out (in progress)</text>
          <text class="warn">• Vendor licence for the sync add-on · by 2026-12-01 (condition 4) · declined</text>
          <text class="muted">It goes back to plan gate when they clear. B changes them.</text>
          <text class="muted">Blocks: TKT-1415</text>
        </column>
      </scroll>

      <column class="note">
        <text id="noteHint" class="muted">Ids to add, -id to remove, or a condition: 2283, -2290, Parts on order by 12/1, -c4</text>
        <field id="note" placeholder="Prerequisites"/>
      </column>

      <row id="actions" class="actions">
        <!-- Buttons are added in code; the declined-prerequisite set. -->
        <button action="stillBlocked:" default="yes">Still blocked ⏎</button>
        <button action="goAheadWithout:">Go ahead without it G</button>
        <button action="prerequisites:">Prerequisites… B</button>
      </row>

      <box class="composerbox"><scroll class="composer"><view id="composer" type="NSTextView"/></scroll></box>
    </column>
  </box>

  <separator/>
  <row class="undo">
    <label id="undoLabel" class="muted">Prerequisites changed on TKT-1409: +2283 · goes in 10 s</label>
    <button id="undo" action="undo:">Undo (Ctrl+Z)</button>
  </row>
</column>

<style>
  /* Today's AIMTriageDeskView -layout, approximated: fixed constants
     (RailWidth 270, PulseHeight 24, BarHeight 34, UndoHeight 30,
     ComposeHeight 150), the card at least 200 wide, nothing wraps. What
     doesn't fit is clipped; the undo bar stays pinned. */
  .desk      { background-color: Canvas; }
  .desk > *  { flex-shrink: 0; }
  .pulse     { height: 24px; gap: 4px; padding: 0 6px; align-items: center; }
  .pulse > * { flex-shrink: 0; }
  .narrow-only { display: none; }
  .body      { flex: 1 1 0px; min-height: 0; flex-direction: row; overflow: hidden; }
  .railpane  { flex: none; width: 270px; gap: 6px; padding: 6px; background-color: -tr-window-background; }
  .railpane > * { flex-shrink: 0; }
  #filter    { height: 24px; }
  .rail      { flex: 1 1 0px; min-height: 0; }
  .rail-list { gap: 0px; }
  .section   { color: GrayText; font-weight: bold; height: 22px; margin-top: 6px; }
  .group     { color: GrayText; height: 20px; }
  .row       { height: 38px; padding: 2px 8px; }
  .row-title { font-weight: bold; }
  .row-meta  { color: GrayText; }
  .selected, .inbatch-selected { background-color: Highlight; }
  .main      { flex: 1 0 200px; min-width: 200px; gap: 6px; padding: 8px; overflow: hidden; }
  .main > *  { flex-shrink: 0; }
  .main > .cardscroll { flex: 1 1 0px; min-height: 0; }
  .cardtext  { gap: 6px; }
  .card-title, .batch-title { font-size: 16px; font-weight: bold; }
  .heading   { font-weight: bold; }
  .item-title { font-weight: bold; }
  .item-line { margin-left: 16px; }
  .muted     { color: GrayText; }
  .warn      { color: -tr-error; }
  .note      { gap: 0px; }
  #noteHint  { height: 18px; }
  #note      { height: 24px; }
  .actions   { height: 34px; gap: 8px; align-items: center; }
  .actions > * { flex-shrink: 0; }
  .wide-only { display: flex; }
  .composerbox { height: 150px; border: 1px; border-color: -tr-separator; padding: 2px; }
  .composer  { flex: 1; }
  .batch-hidden { display: none; }
  .undo      { height: 30px; gap: 8px; padding: 0 8px; align-items: center; }
  .undo > *  { flex-shrink: 0; }
  /* The app's undo label truncates beside the fixed 150pt Undo button. */
  #undoLabel { flex: 1 1 0px; min-width: 0; }
  #undo      { width: 150px; }

  /* Selected rows: text on Highlight is HighlightText. */
  .selected .row-title, .selected .row-meta,
  .inbatch-selected .row-title, .inbatch-selected .row-meta { color: HighlightText; }
</style>
