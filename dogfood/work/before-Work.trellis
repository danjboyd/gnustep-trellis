<!-- owner: AIMWorkView -->
<!-- AIManager's Work tab as it lays out today, approximated in Trellis for
     a before/after comparison (from the app developer's description of
     AIMWallView and AIMAgentDetailView). Not a proposal. Made-up data.
     - A fixed split: the wall, then the detail panel at 360px.
     - Tiles are 110px tall whatever their content; every line is drawn
       on one line and clipped (the headline gets two lines at most).
     - Group headers are ALL CAPS with the count after two spaces.
     - The detail panel's controls are placed by hand at fixed sizes; the
       button rows don't wrap.
     - No "Focus today" strip. -->
<column id="work" class="pane">
  <box class="body">
    <column class="wallpane">
      <scroll id="wallScroll" class="wallscroll">
        <column class="wall">
          <label class="group" no-outlet="yes">NEEDS YOU  (1)</label>
          <box class="tiles">
            <row class="tile selected">
              <box class="bar needs"></box>
              <column class="tile-body">
                <row class="tile-row"><label class="name grow">agent-a</label><box class="pill"><label class="pill-text">acct-2 82%</label></box></row>
                <row class="tile-row"><label class="status needs-text grow">needs you: pick the release channel</label><label class="muted small where">host-1 · claude</label></row>
                <label class="badges">ask open</label>
                <label class="headline">Ship 2.0 as beta or stable? Both builds pass; beta keeps the old updater one more week.</label>
                <label class="foot mgr-note">Manager: answer before the 3 pm build</label>
              </column>
            </row>
          </box>
          <label class="group" no-outlet="yes">WORKING  (3)</label>
          <box class="tiles">
            <row class="tile">
              <box class="bar working"></box>
              <column class="tile-body">
                <row class="tile-row"><label class="name grow">build-bot</label></row>
                <row class="tile-row"><label class="status muted grow">building the 2.0 candidate</label><label class="muted small where">host-2 · claude</label></row>
                <label class="headline">Linking the Windows installer; macOS and Linux packages are done.</label>
                <label class="foot goal">Today 3/5 · Ship the 2.0 candidate</label>
              </column>
            </row>
            <row class="tile">
              <box class="bar working"></box>
              <column class="tile-body">
                <row class="tile-row"><label class="name grow">docs-bot</label></row>
                <row class="tile-row"><label class="status muted grow">writing the upgrade guide</label><label class="muted small where">host-1 · claude</label></row>
                <label class="badges">2 unread</label>
                <label class="headline">Draft of the migration section is up for review.</label>
                <label class="foot goal">Today 1/4 · Upgrade guide for 2.0</label>
              </column>
            </row>
            <row class="tile">
              <box class="bar working"></box>
              <column class="tile-body">
                <row class="tile-row"><label class="name grow">test-bot</label><box class="pill"><label class="pill-text">acct-1 64%</label></box></row>
                <row class="tile-row"><label class="status muted grow">running the nightly suite</label><label class="muted small where">host-3 · codex</label></row>
                <label class="headline">412 of 980 tests done, no failures so far.</label>
                <label class="foot goal">Today 2/3 · Nightly suite green</label>
              </column>
            </row>
          </box>
          <label class="group" no-outlet="yes">IDLE  (2)</label>
          <box class="tiles">
            <row class="tile">
              <box class="bar idle"></box>
              <column class="tile-body">
                <row class="tile-row"><label class="name grow">agent-b</label></row>
                <row class="tile-row"><label class="status muted grow">idle since 10:40</label><label class="muted small where">host-2 · claude</label></row>
                <label class="headline">Finished the settings screen; waiting for the next item.</label>
                <label class="foot purpose">Keeps Project Beta's UI moving</label>
              </column>
            </row>
            <row class="tile">
              <box class="bar idle"></box>
              <column class="tile-body">
                <row class="tile-row"><label class="name grow">data-bot</label></row>
                <row class="tile-row"><label class="status muted grow">idle since 09:15</label><label class="muted small where">host-3 · claude</label></row>
                <label class="headline">Weekly numbers exported.</label>
                <label class="foot purpose">Exports and checks the weekly reports</label>
              </column>
            </row>
          </box>
          <label class="group" no-outlet="yes">STOPPED  (1)</label>
          <box class="tiles">
            <row class="tile">
              <box class="bar stopped"></box>
              <column class="tile-body">
                <row class="tile-row"><label class="name grow">agent-c</label></row>
                <row class="tile-row"><label class="status muted grow">stopped</label><label class="muted small where">host-1 · claude</label></row>
                <label class="badges">session ended</label>
                <label class="foot purpose">Owns Project Gamma's sync service</label>
              </column>
            </row>
          </box>
        </column>
      </scroll>
    </column>
    <column id="detail" class="detail">
      <label id="detailName" class="detail-name">agent-a</label>
      <label id="detailMeta" class="muted">Project Alpha · host-1 · claude</label>
      <label id="detailHealth" class="muted">Healthy · context 41% · last seen 1 min ago</label>
      <row class="buttons">
        <button id="launch" action="launchAgent:">Launch</button>
        <button id="resume" action="resumeAgent:">Resume</button>
        <button id="stop" action="stopAgent:">Stop</button>
      </row>
      <row class="buttons">
        <button action="openTerminal:">Terminal</button>
        <button action="captureScreen:">Capture</button>
        <button action="clearContext:">Clear</button>
        <button action="rebind:">Rebind</button>
        <button action="editAgent:">Edit</button>
        <button action="retireAgent:">Retire</button>
      </row>
      <label id="detailStatus">Needs you: pick the release channel for 2.0.</label>
      <label class="section-label" no-outlet="yes">GOALS</label>
      <text id="goals" class="goals">Purpose: ships Project Alpha's releases. Project goal: 2.0 out by the end of the month. Today: answer the release-channel question, then tag the candidate.</text>
      <row class="buttons">
        <button action="useDraft:">Use draft</button>
        <button action="showProject:">Project</button>
      </row>
      <label class="section-label" no-outlet="yes">CHECKS</label>
      <label id="checks">Build green · tests green · 1 ask open</label>
      <label id="messageLabel" class="section-label" label-for="message">MESSAGE</label>
      <scroll class="message"><view id="message" type="NSTextView"/></scroll>
      <label id="screenLabel" class="section-label" label-for="screen">SCREEN</label>
      <scroll class="screen"><view id="screen" type="NSTextView"/></scroll>
    </column>
  </box>
</column>

<style>
  .pane       { background-color: -tr-window-background; }
  .body       { flex: 1; min-height: 0; flex-direction: row; }
  .wallpane   { flex: 1; min-width: 0; }
  .wallscroll { flex: 1; min-height: 0; }
  .wall       { gap: 10px; padding: 12px; }
  .group      { color: GrayText; font-weight: bold; height: 28px; }
  .tiles      { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }
  .tile       { height: 110px; overflow: hidden; background-color: Canvas; border: 1px;
                border-color: -tr-separator; border-radius: 6px; }
  .selected   { border: 2px; border-color: AccentColor; }
  .bar        { flex: none; width: 5px; }
  .bar.needs   { background-color: Mark; }
  .bar.working { background-color: AccentColor; }
  .bar.idle    { background-color: GrayText; }
  .bar.stopped { background-color: -tr-error; }
  .tile-body  { flex: 1; min-width: 0; gap: 2px; padding: 6px 10px; overflow: hidden; }
  .tile-row   { gap: 8px; align-items: center; }
  .tile-row > * { min-width: 0; }
  .name       { font-weight: bold; }
  .grow       { flex: 1; min-width: 0; }
  .pill       { flex: none; padding: 0 8px; border-radius: 8px; background-color: Mark; }
  .pill-text  { font-size: 10px; font-weight: bold; color: MarkText; }
  .status     { font-size: 11px; }
  .needs-text { font-size: 11px; font-weight: bold; color: LinkText; }
  .where      { flex: 0 1 auto; max-width: 45%; }
  .badges     { font-size: 11px; font-weight: bold; color: -tr-error; }
  .headline   { font-size: 12px; }
  .foot       { font-size: 11px; color: GrayText; }
  .foot.mgr-note { font-weight: bold; color: CanvasText; }
  .muted      { color: GrayText; }
  .small      { font-size: 12px; }

  .detail     { flex: none; width: 360px; gap: 6px; padding: 12px; background-color: Canvas; overflow: hidden; }
  .detail-name { font-size: 16px; font-weight: bold; }
  .buttons    { gap: 6px; height: 30px; }
  .section-label { color: GrayText; font-weight: bold; }
  .goals      { height: 48px; }
  .message    { flex: none; height: 80px; }
  .screen     { flex: 1; min-height: 0; }
</style>
