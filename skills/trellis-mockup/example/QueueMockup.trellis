<!-- owner: QueueMockupController -->
<!-- A mockup with obviously fake data: see skills/trellis-mockup/SKILL.md. -->
<column id="queue" class="page">
  <row class="toolbar">
    <label class="title" no-outlet="yes">Work queue (sample)</label>
    <spacer/>
    <segmented id="filter" class="filter" a11y-label="Filter" items="All, Waiting, Done" selected="All"/>
    <field id="search" class="search" placeholder="Search sample items"/>
  </row>
  <row class="cards">
    <column class="card">
      <label class="card-head" no-outlet="yes">Waiting on you</label>
      <label id="waitingCount" class="big">3</label>
    </column>
    <column class="card">
      <label class="card-head" no-outlet="yes">In progress</label>
      <label id="activeCount" class="big">5</label>
    </column>
    <column class="card">
      <label class="card-head" no-outlet="yes">Done today</label>
      <label id="doneCount" class="big">12</label>
    </column>
  </row>
  <scroll class="list">
    <column class="rows">
      <row class="item">
        <label id="item1" class="item-title" wraps="yes">DEMO-101 Example Agent A: review the sample layout</label>
        <button action="openItem:">Open</button>
      </row>
      <row class="item">
        <label id="item2" class="item-title" wraps="yes">DEMO-102 Example Agent B: answer a placeholder question</label>
        <button action="openItem:">Open</button>
      </row>
      <row class="item">
        <label id="item3" class="item-title" wraps="yes">DEMO-103 Example Agent C: approve a made-up change</label>
        <button action="openItem:">Open</button>
      </row>
    </column>
  </scroll>
  <row class="footer">
    <checkbox id="autoRefresh" state="on">Refresh every minute</checkbox>
    <spacer/>
    <button action="refresh:" default="yes">Refresh</button>
  </row>
</column>

<style>
  .page      { container-type: inline-size; padding: 16px; gap: 12px; }
  .toolbar   { gap: 8px; align-items: center; }
  .title     { font-size: 17px; font-weight: bold; }
  .search    { width: 180px; min-width: 120px; }
  .cards     { gap: 12px; }
  .card      { flex: 1; padding: 10px; gap: 2px; border-width: 1px; border-radius: 6px; }
  .card-head { color: GrayText; }
  .big       { font-size: 22px; font-weight: bold; }
  .list      { flex: 1; min-height: 120px; }
  .rows      { gap: 6px; }
  .item      { gap: 8px; align-items: center; }
  .item-title { flex: 1; min-width: 0; }
  .footer    { gap: 8px; align-items: center; }

  @container (max-width: 520px) {
    .toolbar { flex-wrap: wrap; }
    .search  { flex: 1; width: auto; }
    .cards   { flex-direction: column; align-items: stretch; }
  }
</style>
